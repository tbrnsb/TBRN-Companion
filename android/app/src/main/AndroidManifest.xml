<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      Location permissions.

      These were missing entirely, which is why "Current location" always
      reported unavailable and Android showed no location entry for the app in
      system Settings. geolocator cannot request a permission the manifest
      never declares, so it failed before it ever asked.

      FINE/COARSE are what let the app read a position at all, and the only
      runtime prompt for them is `Geolocator.requestPermission()` — asked from
      a user action ("Use current location", the locate button), never at
      startup.

      BACKGROUND IS DECLARED, NOT REQUESTED, and that is deliberate. The
      saved-place arrival check runs only while the app is open and has a fix:
      `LocationProvider._checkArrivals` says so in as many words, and the place
      screen repeats it ("Within 1.0 km, while the app is running"). This build
      does NOT do background geofencing — nothing asks for "Allow all the time",
      there is no background location request flow, and no foreground service
      would keep a check alive after the app is closed. Firing on arrival with
      the app killed is a much larger thing to put in someone's pocket without
      asking, which is exactly why it was left out.

      The declaration itself is kept rather than removed, because deleting a
      manifest permission is a behaviour change beyond what this comment fixes.
      As long as nothing requests it, it grants nothing and blocks nothing.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      "Remind me" schedules with AlarmManager.setAlarmClock so a 10:00
      departure reminder fires at 10:00. Android 12+ REFUSES that call —
      ExactAlarmPermissionException, swallowed at the tap handler — unless
      this permission is declared and the user has enabled "Alarms &
      reminders". Without the declaration the toggle does not exist in
      Settings at all and every schedule on Android 12+ failed silently into
      a "could not be set" snackbar. Declared here; the app then checks the
      toggle from the user's own tap (NotificationService.scheduleAt) and
      opens the system switch once if it is off.

      On Android 13+ the toggle starts OFF (the OS no longer grants it by
      default), which is exactly why the request happens where the reminder
      is being set rather than at first launch.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!--
      Android backs app data up to the user's Google account by default. This
      app promises that nothing leaves the phone, and an OS-level copy to a
      cloud backup service is the one thing that would quietly break that, so
      backup is off.
    -->
    <application
        android:label="TBRN Companion"
        android:name="${applicationName}"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>

        <!--
          Maps. Without these two, "Open in maps" can NEVER work on Android 11+.

          Since API 30 an app cannot see which other apps can handle an intent
          unless it declares the scheme here. `canLaunchUrl` therefore returned
          false for BOTH candidates the launcher tried (the `geo:` scheme and
          the Google Maps web URL), so the feature reported "No maps app found"
          on a phone that had a perfectly good maps app installed, and every
          attempt ended in the coordinates-in-a-snackbar fallback. The failure
          looked exactly like a missing app, because from inside the app that is
          precisely what package visibility reports.

          Declared as schemes rather than as one app's package, so this keeps
          working whichever maps app answers: Google Maps, Organic Maps, OsmDroid
          or anything else that registers for `geo:`.
        -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="geo"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
