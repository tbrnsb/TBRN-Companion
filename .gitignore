# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
# `/build/` above is root-anchored, so the platform build directories were
# still being tracked. Match them at any depth.
/android/build/
/ios/Build/
/coverage/

# Generated IDE / Gradle problem reports
**/problems-report.html

# Local agent session transcripts
session-ses_*.md

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# OpenCode agent tooling config (per-machine, not app source)
opencode.jsonc

# Session recovery material: a git bundle of this repo's own history, a patch of
# in-flight work, and copies of changed files. Useful on disk, but a bundle
# inside the repo it duplicates is dead weight in every clone forever.
backup/
.verify-logs/
.rewrite/
.verify-tmp/
.gate-out.log

# Session state and editor/agent handoff notes. These describe how the work was
# driven, not what the app is, and they carry absolute paths from one machine.
# They stay on disk for recovery and never travel with a clone.
.planning/
.continue/
HANDOFF.md
session-ses_*.md

# Android release signing. The keystore must never be pushed anywhere: whoever
# holds this key can sign updates that Android accepts as yours. Losing it means
# the app can never be updated again, so back the file up somewhere safe.
*.jks
*.keystore
android/key.properties
